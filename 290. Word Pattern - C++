class Solution {
public:
    bool wordPattern(string pattern, string s) {
        vector<string> words;
        string word;
        stringstream ss(s);
        while (ss >> word) {
            words.push_back(word);
        }
        if (pattern.size() != words.size())
            return false;
        unordered_map<char, string> a;
        unordered_map<string, char> b;
        for (int i = 0; i < pattern.size(); i++) {
            char c = pattern[i];
            string w = words[i];
            if (a.count(c) && a[c] != w)
                return false;
            if (b.count(w) && b[w] != c)
                return false;
            a[c] = w;
            b[w] = c;
        }
        return true;
    }
};
