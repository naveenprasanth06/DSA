
class Solution {
public:
    string removeOuterParentheses(string s) {
        string result;
        int level=0;
        for(char c : s){
            if(c=='('){
                level++;
                if(level>1)result+=c;
            }else{
                level--;
                if(level>0)result+=c;
            }
        }
        return result;
    }
};
