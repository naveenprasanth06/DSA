class Solution {
public:
    string removeOuterParentheses(string s) {
    string result;
    int n = s.size();
    int balance = 0;
    for(int  i = 0; i < n; i++) {
        if(s[i] == '(') {
            if(balance > 0) {
                result = result + s[i];
            } balance++;
            } else {
                balance--;
                if(balance > 0) {
                    result = result + s[i];
                }
            }
        }
        return result;
    }
};
