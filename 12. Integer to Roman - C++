class Solution {
public:
    string intToRoman(int num) {
        string res="";
        int i=1;
        while(num>0){
            int digit = num%10;
            if(i==1){
                if(digit == 1) res = "I" + res;
                else if(digit == 2) res = "II" + res;
                else if(digit == 3) res = "III" + res;
                else if(digit == 4) res = "IV" + res;
                else if(digit == 5) res = "V" + res;
                else if(digit == 6) res = "VI" + res;
                else if(digit == 7) res = "VII" + res;
                else if(digit == 8) res = "VIII" + res;
                else if(digit == 9) res = "IX" + res;
            }
            else if(i==2){
                if(digit == 1) res = "X" + res;
                else if(digit == 2) res = "XX" + res;
                else if(digit == 3) res = "XXX" + res;
                else if(digit == 4) res = "XL" + res;
                else if(digit == 5) res = "L" + res;
                else if(digit == 6) res = "LX" + res;
                else if(digit == 7) res = "LXX" + res;
                else if(digit == 8) res = "LXXX" + res;
                else if(digit == 9) res = "XC" + res;
            }
            else if(i==3){
                if(digit == 1) res = "C" + res;
                else if(digit == 2) res = "CC" + res;
                else if(digit == 3) res = "CCC" + res;
                else if(digit == 4) res = "CD" + res;
                else if(digit == 5) res = "D" + res;
                else if(digit == 6) res = "DC" + res;
                else if(digit == 7) res = "DCC" + res;
                else if(digit == 8) res = "DCCC" + res;
                else if(digit == 9) res = "CM" + res;
            }
            else if(i==4){
                if(digit == 1) res = "M" + res;
                else if(digit == 2) res = "MM" + res;
                else if(digit == 3) res = "MMM" + res;
            }
            i++;
            num=num/10;
        }
        return res;
    }
};
