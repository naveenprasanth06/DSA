class Solution {
public:
    void gameOfLife(vector<vector<int>>& board) {
        int rows = board.size();
        int cols = board[0].size();

        // Make a copy of the original board
        vector<vector<int>> old = board;

        for (int i = 0; i < rows; i++) {
            for (int j = 0; j < cols; j++) {

                int live = 0;

                // Check 8 neighbours
                for (int x = -1; x <= 1; x++) {
                    for (int y = -1; y <= 1; y++) {

                        if (x == 0 && y == 0)
                            continue;

                        int r = i + x;
                        int c = j + y;

                        if (r >= 0 && r < rows &&
                            c >= 0 && c < cols) {

                            if (old[r][c] == 1)
                                live++;
                        }
                    }
                }

                // Apply the rules
                if (old[i][j] == 1) {
                    if (live < 2 || live > 3)
                        board[i][j] = 0;
                }
                else {
                    if (live == 3)
                        board[i][j] = 1;
                }
            }
        }
    }
};
