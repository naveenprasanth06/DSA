    class Solution {
    public:
        void solve(int n, int k, string &current, vector<string> &result) {
            if(current.length() == n) {
                result.push_back(current);
                return;
            }
            for(char ch : {'a','b','c'}) {
                if(current.size() > 0 && current.back() == ch) 
                    continue;
                    current.push_back(ch);
                    solve(n, k, current, result);
                    current.pop_back();
            }
        }
        string getHappyString(int n, int k) {
            vector<string> result;
            string current = "";
            solve(n, k, current, result);
            if(k > result.size())
            return "";
            return result[k-1];
        }
    };
