class Solution {
public:
    string frequencySort(string s) {
        pair<int, char> letters[128];
        for(int i = 0; i < 128; i++) {
            letters[i].first = 0;
            letters[i].second = char(i);
        }
        for(char ch : s) {
            letters[(unsigned char)ch].first++;
        }
        sort(letters, letters + 128, [](pair<int, char> a, pair<int, char> b) {
            if(a.first != b.first) 
                return a.first > b.first;
                return a.second < b.second;
        });
        string result = "";
        for(int i = 0; i < 128; i++) {
            if(letters[i].first > 0) {
                result = result + string(letters[i].first, letters[i].second);
            }
        }
        return result;
    }
};
