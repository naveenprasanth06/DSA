class Solution {
public:
    int jump(vector<int>& nums) {
        int dist = 0;
        int currentEnd = 0;
        int jump = 0;
        for(int i = 0; i < nums.size() - 1; i++) {
            dist = max(dist, i + nums[i]);
            if (i == currentEnd) {
                jump++;
                currentEnd = dist;
            }
        }
        return jump;
    }
};
