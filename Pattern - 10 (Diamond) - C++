#include <bits/stdc++.h>
using namespace std;
int main() {
    int N = 5;
    // Upper half (including middle line)
    for (int i = 1; i <= N; i++) {
        // spaces
        for (int j = 1; j <= N - i; j++) {
            cout << " ";
        }
        // stars
        for (int j = 1; j <= (2 * i - 1); j++) {
            cout << "*";
        }
        cout << endl;
    }
    // Lower half
    for (int i = N - 1; i >= 1; i--) {
        // spaces
        for (int j = 1; j <= N - i; j++) {
            cout << " ";
        }
        // stars
        for (int j = 1; j <= (2 * i - 1); j++) {
            cout << "*";
        }
        cout << endl;
    }
    return 0;
}
