#include <bits/stdc++.h>
using namespace std;
class Solution {
public:
    void pattern6(int N) {
        for (int i = 1; i <= N; i++) {
            for (int j = N; j >= i; j--) {
                cout << i << " ";
            }
            cout << endl;
        }
    }
};
int main() {
    Solution sol;
    int N = 5;
    sol.pattern6(N);
    return 0;
}
