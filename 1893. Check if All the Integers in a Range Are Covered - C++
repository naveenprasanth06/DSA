class Solution {
public:
    bool isCovered(vector<vector<int>>& ranges, int left, int right) {
        for(int i = left; i <= right; i++) {
            bool covered = false;
            for(auto &r : ranges) {
                if( i >= r[0] && i <= r[1]) {
                    covered = true;
                    break;
                }
            }
            if(!covered)
            return false;
        }
        return true;
    }
};
