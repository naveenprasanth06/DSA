#include <bits/stdc++.h>
using namespace std;
class Solution {
public:
    void pattern4(int N) {
        for (int i = 0; i <= N; i++) {
            for (int j = 1; j <= i; j++) {
                cout << j << " ";
            }
            cout << endl;
        }
    }
};
int main() {
    Solution sol;
    int N = 5;
    sol.pattern4(N);
    return 0;
}
